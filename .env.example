# Copy this file's variable name into your hosting platform's
# environment variable settings (e.g. Vercel → Project Settings →
# Environment Variables). Never fill in a real value here or commit
# a file named ".env" with a real key in it.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# From Supabase: Project Settings -> API. SUPABASE_URL and the anon key also
# get hardcoded directly into signup.html and discover.html (that's normal
# for Supabase's anon key - it's meant to be public). Only the service role
# key stays here as a secret, used only by api/resume-account.js and
# api/admin-accounts.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Make this up yourself - it's the shared secret admin.html sends to prove
# it's allowed to list every student's data. Must match the code typed into
# the sign-up page's admin step exactly.
ADMIN_CODE=BeyondCircumstances2026(Arjit+Arthur)
